# Supabase — server-only, used by the /api/waitlist route.
# Set these in Vercel (Project → Settings → Environment Variables) and in
# .env.local for local dev. The service_role key is a secret: never prefix it
# NEXT_PUBLIC_ and never import lib/supabase.ts from a client component.
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
